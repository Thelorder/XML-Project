<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for StreamingAssets/Dialog/analysis.xml: what the turn analyzer looks for
  and how each finding moves the NPC's rapport. The LLM only classifies a message
  into these behaviours; all points are applied by the game from this file.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="IdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Points">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="-20"/>
      <xs:maxInclusive value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Polarity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="positive"/>
      <xs:enumeration value="negative"/>
      <!-- depends on the character; points come from BehaviourOverrides -->
      <xs:enumeration value="neutral"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="BehaviourType">
    <xs:sequence>
      <xs:element name="Description" type="NonEmptyText"/>
      <!-- Few-shot examples of player lines showing this behaviour -->
      <xs:element name="Example" type="NonEmptyText" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="IdType" use="required"/>
    <xs:attribute name="polarity" type="Polarity" use="required"/>
    <xs:attribute name="rapport" type="Points" use="required"/>
    <!-- Rubric criterion this behaviour counts towards (matched against the character's rubric) -->
    <xs:attribute name="criterion" type="IdType"/>
    <!-- Rule applied by the game, not the LLM: any message of at most this many words
         that is not a question gets this behaviour automatically -->
    <xs:attribute name="autoMaxWords" type="xs:positiveInteger"/>
  </xs:complexType>

  <xs:complexType name="ScoringType">
    <xs:sequence>
      <!-- Points per trigger strength (1-3) when the player handles a trigger well/badly.
           "well" counts fully the first time only; later hits on the same trigger give repeatWell. -->
      <xs:element name="Trigger">
        <xs:complexType>
          <xs:attribute name="well" type="Points" use="required"/>
          <xs:attribute name="repeatWell" type="Points" default="0"/>
          <xs:attribute name="badly" type="Points" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- Points for crossing a boundary, by its severity; each crossing is also a strike -->
      <xs:element name="Boundary">
        <xs:complexType>
          <xs:attribute name="low" type="Points" use="required"/>
          <xs:attribute name="medium" type="Points" use="required"/>
          <xs:attribute name="high" type="Points" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- Points when the character hinted at an emotional cue -->
      <xs:element name="Cue">
        <xs:complexType>
          <xs:attribute name="noticed" type="Points" use="required"/>
          <xs:attribute name="missed" type="Points" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <!-- Cap on how far one message can move rapport, so one misread can't decide a conversation -->
    <xs:attribute name="maxTurnChange" type="xs:positiveInteger" default="15"/>
  </xs:complexType>

  <!-- Hidden notes given to the Actor LLM depending on the current rapport band -->
  <xs:complexType name="MoodsType">
    <xs:sequence>
      <xs:element name="Cold" type="NonEmptyText"/>
      <xs:element name="Neutral" type="NonEmptyText"/>
      <xs:element name="Warm" type="NonEmptyText"/>
      <!-- Added when one more boundary strike will end the conversation -->
      <xs:element name="LastWarning" type="NonEmptyText"/>
      <!-- Used to make the character end the conversation after too many strikes -->
      <xs:element name="Leave" type="NonEmptyText"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Analysis">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Behaviours">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Behaviour" type="BehaviourType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Scoring" type="ScoringType"/>
        <xs:element name="Moods" type="MoodsType"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="UniqueBehaviourId">
      <xs:selector xpath="Behaviours/Behaviour"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
