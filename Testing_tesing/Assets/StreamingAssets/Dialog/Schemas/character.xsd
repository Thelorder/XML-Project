<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for a virtual conversation partner.
  One XML file per character in StreamingAssets/Dialog/Characters/.
  The game builds the Actor LLM system prompt from this description and
  gives the EvaluationRubric to the Evaluator LLM - no C# changes needed
  to add or change a character.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ===== Simple types ===== -->

  <xs:simpleType name="IdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9_]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Big Five trait value, 0 = low, 1 = high -->
  <xs:simpleType name="TraitValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Weight">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Difficulty">
    <xs:restriction base="xs:string">
      <xs:enumeration value="easy"/>
      <xs:enumeration value="medium"/>
      <xs:enumeration value="hard"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LowMediumHigh">
    <xs:restriction base="xs:string">
      <xs:enumeration value="low"/>
      <xs:enumeration value="medium"/>
      <xs:enumeration value="high"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BoundaryStrictness">
    <xs:restriction base="xs:string">
      <xs:enumeration value="relaxed"/>
      <xs:enumeration value="normal"/>
      <xs:enumeration value="strict"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TriggerKind">
    <xs:restriction base="xs:string">
      <!-- something the character loves talking about -->
      <xs:enumeration value="interest"/>
      <!-- a sore spot: careless handling hurts rapport -->
      <xs:enumeration value="sensitive"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TriggerEffect">
    <xs:restriction base="xs:string">
      <xs:enumeration value="warm"/>
      <xs:enumeration value="cold"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Strength">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Scale">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+-\d+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== Complex types ===== -->

  <xs:complexType name="OceanType">
    <xs:attribute name="O" type="TraitValue" use="required"/>
    <xs:attribute name="C" type="TraitValue" use="required"/>
    <xs:attribute name="E" type="TraitValue" use="required"/>
    <xs:attribute name="A" type="TraitValue" use="required"/>
    <xs:attribute name="N" type="TraitValue" use="required"/>
  </xs:complexType>

  <xs:complexType name="PersonalityType">
    <xs:sequence>
      <xs:element name="OCEAN" type="OceanType"/>
      <!-- Optional free-text nuance on top of the numbers -->
      <xs:element name="Description" type="NonEmptyText" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CommunicationStyleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="directness" type="LowMediumHigh" use="required"/>
        <xs:attribute name="humor" type="LowMediumHigh" use="required"/>
        <xs:attribute name="verbosity" type="LowMediumHigh" use="required"/>
        <xs:attribute name="boundaries" type="BoundaryStrictness" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="InterestsType">
    <xs:sequence>
      <xs:element name="Like" type="NonEmptyText" maxOccurs="unbounded"/>
      <xs:element name="Dislike" type="NonEmptyText" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BoundaryType">
    <xs:simpleContent>
      <xs:extension base="NonEmptyText">
        <xs:attribute name="id" type="IdType" use="required"/>
        <xs:attribute name="severity" type="LowMediumHigh" default="medium"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="BoundariesType">
    <xs:sequence>
      <xs:element name="Boundary" type="BoundaryType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TriggerType">
    <xs:sequence>
      <!-- Comma-separated topics/words that activate the trigger -->
      <xs:element name="Topics" type="NonEmptyText"/>
      <!-- How the character's behaviour shifts once triggered -->
      <xs:element name="Reaction" type="NonEmptyText"/>
    </xs:sequence>
    <xs:attribute name="id" type="IdType" use="required"/>
    <xs:attribute name="kind" type="TriggerKind" use="required"/>
    <xs:attribute name="effect" type="TriggerEffect" use="required"/>
    <xs:attribute name="strength" type="Strength" default="1"/>
  </xs:complexType>

  <xs:complexType name="TriggersType">
    <xs:sequence>
      <xs:element name="Trigger" type="TriggerType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Emotional signals the character drops into the conversation;
       the Evaluator checks whether the player noticed them. -->
  <xs:complexType name="CueType">
    <xs:simpleContent>
      <xs:extension base="NonEmptyText">
        <xs:attribute name="id" type="IdType" use="required"/>
        <xs:attribute name="topic" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="EmotionalCuesType">
    <xs:sequence>
      <xs:element name="Cue" type="CueType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GoalsType">
    <xs:sequence>
      <xs:element name="SecretGoal" type="NonEmptyText"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ConversationRulesType">
    <xs:attribute name="minTurns" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="maxTurns" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="maxBoundaryStrikes" type="xs:positiveInteger" default="2"/>
  </xs:complexType>

  <xs:simpleType name="Percent">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Rapport runs 0..100. Below coldBelow the character turns guarded, above warmAbove they open up. -->
  <xs:complexType name="RapportRulesType">
    <xs:attribute name="start" type="Percent" default="40"/>
    <xs:attribute name="coldBelow" type="Percent" default="25"/>
    <xs:attribute name="warmAbove" type="Percent" default="65"/>
  </xs:complexType>

  <!-- Per-character points for behaviours from analysis.xml (ids are checked by the game) -->
  <xs:complexType name="BehaviourOverridesType">
    <xs:sequence>
      <xs:element name="Override" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="behaviour" type="IdType" use="required"/>
          <xs:attribute name="rapport" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="-20"/>
                <xs:maxInclusive value="20"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CriterionType">
    <xs:sequence>
      <xs:element name="Description" type="NonEmptyText"/>
    </xs:sequence>
    <xs:attribute name="id" type="IdType" use="required"/>
    <xs:attribute name="label" type="NonEmptyText" use="required"/>
    <xs:attribute name="weight" type="Weight" use="required"/>
    <xs:attribute name="scale" type="Scale" default="1-5"/>
  </xs:complexType>

  <xs:complexType name="EvaluationRubricType">
    <xs:sequence>
      <xs:element name="Criterion" type="CriterionType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="totalScore" type="xs:positiveInteger" default="100"/>
  </xs:complexType>

  <!-- ===== Root ===== -->

  <xs:element name="Character">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Name" type="NonEmptyText"/>
        <xs:element name="Age" type="xs:positiveInteger"/>
        <xs:element name="Occupation" type="NonEmptyText"/>
        <xs:element name="Background" type="NonEmptyText"/>
        <xs:element name="Personality" type="PersonalityType"/>
        <xs:element name="CommunicationStyle" type="CommunicationStyleType"/>
        <xs:element name="Interests" type="InterestsType"/>
        <xs:element name="Boundaries" type="BoundariesType"/>
        <xs:element name="Triggers" type="TriggersType" minOccurs="0"/>
        <xs:element name="EmotionalCues" type="EmotionalCuesType" minOccurs="0"/>
        <xs:element name="Goals" type="GoalsType"/>
        <!-- First line the character says when the player walks up -->
        <xs:element name="Greeting" type="NonEmptyText"/>
        <xs:element name="ConversationRules" type="ConversationRulesType"/>
        <xs:element name="RapportRules" type="RapportRulesType" minOccurs="0"/>
        <xs:element name="BehaviourOverrides" type="BehaviourOverridesType" minOccurs="0"/>
        <xs:element name="EvaluationRubric" type="EvaluationRubricType"/>
      </xs:sequence>
      <xs:attribute name="id" type="IdType" use="required"/>
      <xs:attribute name="lang" type="xs:language" default="en"/>
      <xs:attribute name="difficulty" type="Difficulty" use="required"/>
    </xs:complexType>

    <!-- Ids must be unique inside their own list -->
    <xs:unique name="UniqueBoundaryId">
      <xs:selector xpath="Boundaries/Boundary"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="UniqueTriggerId">
      <xs:selector xpath="Triggers/Trigger"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="UniqueCueId">
      <xs:selector xpath="EmotionalCues/Cue"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="UniqueOverride">
      <xs:selector xpath="BehaviourOverrides/Override"/>
      <xs:field xpath="@behaviour"/>
    </xs:unique>
    <xs:unique name="UniqueCriterionId">
      <xs:selector xpath="EvaluationRubric/Criterion"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
